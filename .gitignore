# Root .gitignore for SchoolClassProject

# Environment files across all subprojects (security guard)
**/.env
**/.env.*
!**/.env.example

# Local process artifacts & runtime locks
deploy/*.pid
deploy/*.log
deploy/backups/*.sql
deploy/heavy_job_proof.txt
.hermes/
.venv/
**/.venv/

# Internal planning & design documents (do not push to repo)
RENCANA_PENYEMPURNAAN_RESOLUSI_RUANG_DAN_KONFLIK_IMPORT.md
RENCANA_REDESIGN_JURNAL_KBM_DAN_PRESENSI.md
RENCANA_PEMBARUAN_SISTEM_PERIZINAN_GURU.md
RENCANA_*.md

# Java crash dumps & local test parse outputs
hs_err_pid*.log
replay_pid*.log
test_parse_*.json

temp_nginx.conf